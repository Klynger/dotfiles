{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // The stock module list, recolored: Tokyo Night blue keys and title,
    // the logo in the theme's blue and cyan
    "logo": {
        "color": {
            "1": "38;2;122;162;247",
            "2": "38;2;125;207;255"
        }
    },
    "display": {
        "color": {
            "keys": "38;2;122;162;247",
            "title": "38;2;122;162;247"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        "terminalfont",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "locale",
        "break",
        "colors"
    ]
}
