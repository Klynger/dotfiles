#!/bin/bash

# Flips light/dark everywhere at once: the GTK color scheme and theme
# variant, the static GTK palette, the shell's own theme and wezterm.

set -euo pipefail

current=$(gsettings get org.gnome.desktop.interface color-scheme)
if [[ "$current" == "'prefer-dark'" ]]; then
    mode="light"
else
    mode="dark"
fi

gsettings set org.gnome.desktop.interface color-scheme "prefer-$mode"

# Clearing first forces GTK to re-read the theme css
gsettings set org.gnome.desktop.interface gtk-theme ""
if [[ "$mode" == "dark" ]]; then
    gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark
else
    gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3
fi

cp "$HOME/.config/gtk-3.0/colors-$mode.css" "$HOME/.config/gtk-3.0/colors.css"
cp "$HOME/.config/gtk-3.0/colors-$mode.css" "$HOME/.config/gtk-4.0/colors.css"

qs ipc call theme setMode "$mode" 2>/dev/null || true

# wezterm re-reads its config on file change and picks the scheme from the
# color scheme setting flipped above
touch "$HOME/.config/wezterm/wezterm.lua" 2>/dev/null || true

notify-send "${mode^} mode enabled"
