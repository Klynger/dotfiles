{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // The stock module list, recolored: honey keys and title, the logo in
    // honey and the palette's orange to match the warm theme
    "logo": {
        "color": {
            "1": "38;2;224;175;104",
            "2": "38;2;255;158;100"
        }
    },
    "display": {
        "color": {
            "keys": "38;2;224;175;104",
            "title": "38;2;224;175;104"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        "terminalfont",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "locale",
        "break",
        "colors"
    ]
}
